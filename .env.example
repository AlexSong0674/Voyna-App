# Voyna 환경변수 템플릿
# 이 파일을 .env로 복사 후 실제 값 입력
# .env는 .gitignore로 보호됨

# ── Supabase ──
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── 카카오 ──
KAKAO_NATIVE_APP_KEY=
KAKAO_REST_API_KEY=
KAKAO_JAVASCRIPT_KEY=
KAKAO_REDIRECT_URI=https://xxxxxxxx.supabase.co/auth/v1/callback

# ── Google OAuth ──
GOOGLE_CLIENT_ID_IOS=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID_WEB=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# ── App ──
APP_BUNDLE_ID=app.voyna
APP_NAME=Voyna

# ── Codemagic ── (Phase 7 이후)
CODEMAGIC_API_KEY=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
